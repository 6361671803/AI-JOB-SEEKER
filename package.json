{
  "name": "agentic-job-finder",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "predev": "node scripts/free-ports.js",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && .venv\\Scripts\\python.exe -m uvicorn app.main:app --port 8000",
    "dev:frontend": "cd frontend && npm run dev"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
